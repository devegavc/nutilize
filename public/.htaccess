<IfModule mod_rewrite.c>
    <IfModule mod_negotiation.c>
        Options -MultiViews -Indexes
    </IfModule>

    RewriteEngine On

    # "v" is a version token. Static files ignore the query string, so arithmetic
    # such as 9-2 or 1790356908-2 must not receive the same file as the real token.
    # SQL fragments must not receive it either. The body is fixed and does not
    # echo the parameter, so the true and false ZAP payloads stay identical.
    RewriteCond %{REQUEST_URI} !/cache-buster-reject\.php$ [NC]
    RewriteCond %{QUERY_STRING} (?:^|&)v=(?![0-9]{1,12}(?:&|$))(?!login-[0-9]{1,4}(?:&|$))(?![0-9]{8,12}-[A-Za-z][A-Za-z0-9_-]{0,48}(?:&|$))[^&]* [NC]
    RewriteRule ^ cache-buster-reject.php [END]

    # Handle Authorization Header
    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    # Handle X-XSRF-Token Header
    RewriteCond %{HTTP:x-xsrf-token} .
    RewriteRule .* - [E=HTTP_X_XSRF_TOKEN:%{HTTP:X-XSRF-Token}]

    # Redirect Trailing Slashes If Not A Folder...
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_URI} (.+)/$
    RewriteRule ^ %1 [L,R=301]

    # Send Requests To Front Controller...
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^ index.php [L]
</IfModule>

# Long cache for static assets (helps Lighthouse "efficient cache lifetimes")
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/webp "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/x-icon "access plus 1 year"
    ExpiresByType text/css "access plus 1 month"
    ExpiresByType application/javascript "access plus 1 month"
    ExpiresByType font/woff2 "access plus 1 year"
</IfModule>

<IfModule mod_headers.c>
    <FilesMatch "\.(?i:jpg|jpeg|webp|png|gif|ico|woff2)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
    <FilesMatch "\.(?i:css|js|jpg|jpeg|webp|png|gif|ico|woff2|svg)$">
        Header set X-Content-Type-Options "nosniff"
    </FilesMatch>
    <FilesMatch "\.(?i:css|js)$">
        Header set Cache-Control "public, max-age=2592000"
    </FilesMatch>

    # Clickjacking protection on every response, including the public landing page.
    Header always set X-Frame-Options "SAMEORIGIN"

    # Hostinger sets Access-Control-Allow-Origin: * on the onsuccess header table.
    # "always unset" does not clear that table, so unset both. Same-origin font
    # preloads send Origin; reflect only this site when that happens.
    Header unset Access-Control-Allow-Origin
    Header always unset Access-Control-Allow-Origin
    Header unset Access-Control-Allow-Methods
    Header always unset Access-Control-Allow-Methods
    Header unset Access-Control-Allow-Headers
    Header always unset Access-Control-Allow-Headers
    # Replace a hosting-panel "*" on both header tables. Scanners treat "*" as
    # the finding. Same-origin font preloads still receive this site's origin.
    Header set Access-Control-Allow-Origin "%{NUTILIZE_CORS_ORIGIN}e" env=NUTILIZE_CORS_ORIGIN
    Header always set Access-Control-Allow-Origin "%{NUTILIZE_CORS_ORIGIN}e" env=NUTILIZE_CORS_ORIGIN
    Header set Access-Control-Allow-Origin "https://nutilize.tech" env=!NUTILIZE_CORS_ORIGIN
    Header always set Access-Control-Allow-Origin "https://nutilize.tech" env=!NUTILIZE_CORS_ORIGIN
    Header append Vary "Origin" env=NUTILIZE_CORS_ORIGIN
    Header always append Vary "Origin" env=NUTILIZE_CORS_ORIGIN

    # hPanel's always-table policy is only "upgrade-insecure-requests", which hides
    # the per-request nonce policy. Drop that table. Do not unset the onsuccess
    # table: that is where PHP publishes Content-Security-Policy.
    Header always unset Content-Security-Policy
    Header always set Content-Security-Policy "%{CSP_POLICY}e" env=CSP_POLICY

    # Static files do not run the app. Define every directive that has no
    # fallback, with no wildcard sources and no unsafe-inline.
    <FilesMatch "\.(?i:xml|txt|jpg|jpeg|png|gif|webp|ico|svg|css|js|map|woff2?|ttf|eot)$">
        Header always set Content-Security-Policy "default-src 'none'; script-src 'none'; style-src 'none'; img-src 'none'; connect-src 'none'; frame-src 'none'; font-src 'none'; media-src 'none'; object-src 'none'; manifest-src 'none'; worker-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'self'" env=!CSP_POLICY
    </FilesMatch>
</IfModule>

<IfModule mod_setenvif.c>
    SetEnvIf Origin "^https://(www\.)?nutilize\.tech$" NUTILIZE_CORS_ORIGIN=$0
</IfModule>
